{
  "name": "ledger-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:smoke": "node tests/smoke/smoke.test.js",
    "validate:openapi": "swagger-cli validate docs/openapi/ms-identity.yaml && swagger-cli validate docs/openapi/ms-ledger.yaml"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
  }
}
