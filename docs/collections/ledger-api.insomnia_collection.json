      "name": "Identity Service"
    },
    {
      "_id": "req_register",
      "_type": "request",
      "parentId": "fld_identity",
      "name": "Register User",
      "method": "POST",
      "url": "{{ _.baseUrl }}:{{ _.identityPort }}/users",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"secret123\"\n}"
      }
    },
    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_identity",
      "name": "Login",
      "method": "POST",
      "url": "{{ _.baseUrl }}:{{ _.identityPort }}/auth",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"secret123\"\n}"
      }
    },
    {
      "_id": "req_list_users",
      "_type": "request",
      "parentId": "fld_identity",
