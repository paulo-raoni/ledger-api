      "method": "GET",
      "url": "{{ _.baseUrl }}:{{ _.identityPort }}/users",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ]
    },
    {
      "_id": "req_get_user",
      "_type": "request",
