# External JWT (public APIs)
JWT_EXTERNAL_SECRET=

# Internal JWT (service-to-service)
JWT_INTERNAL_SECRET=

# Ports
LEDGER_PORT=3001
IDENTITY_PORT=3002

# Databases
LEDGER_DB_URL=postgres://postgres:postgres@ledger-db:5432/ledger
IDENTITY_DB_URL=postgres://postgres:postgres@identity-db:5432/identity

# Internal communication
LEDGER_INTERNAL_BASE_URL=http://ledger-api:3001
IDENTITY_INTERNAL_BASE_URL=http://identity-api:3002
